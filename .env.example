# Development-only values. Copy to .env at the workspace root.
ENVIRONMENT=development
# Local convenience: set false in production; migrations are forward-only but may alter schema.
AUTO_MIGRATE=true
# When using `cd backend`, relative SQLite URLs are interpreted there.
DATABASE_URL=sqlite:///./sentinelauth.db
APP_SECRET=development-placeholder-change-to-32-random-characters
CORS_ORIGINS=http://localhost:5173
SECURE_COOKIES=false
SESSION_HOURS=12
# Required for TOTP enrollment; generate with Fernet.generate_key() command in README.
MFA_ENCRYPTION_KEY=
# Optional SMTP configuration. In local development, absent SMTP returns an explicitly labelled dev-only link.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Absolute frontend URL used in delivered email links, e.g. https://accounts.example.test
PUBLIC_BASE_URL=
